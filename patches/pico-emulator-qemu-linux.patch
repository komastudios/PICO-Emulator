+void PicoemuPipeManager::sendGuestPicoemuContents(const char* service_name,
+                                                  const uint8_t* buf,
+                                                  size_t len) {
+    std::lock_guard<std::mutex> lock(sPicoPipeMapLock);
+    auto pipe = sPicoPipeMap.find(service_name);
+    if (pipe != sPicoPipeMap.end()) {
+        pipe->second->sendGuestPicoemuContents(buf, len);
+    } else {
+        sPendingMap[service_name].assign(buf, buf + len);
+    }
 }
 
