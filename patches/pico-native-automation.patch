+// Copyright 2026 Koma Studios. Licensed under the Apache License, Version 2.0.
+#include "android/emulation/PicoemuPipe.h"
+#include <gtest/gtest.h>
+#include <array>
+#include <cstring>
+#include <future>
+namespace android {
+namespace emulation {
+class PicoemuPipeQueueTest : public ::testing::Test {
+protected:
+    using Queue = PicoemuPipe::WritingState;
+    using Packet = PicoemuPipe::ReadWriteState;
+    static void consume(Packet* packet) {
+        packet->dataSizeTransferred = true;
+        packet->processedBytes = packet->dataSize;
+    }
+    static std::array<int32_t, 3> control(int hand, int code, int value) {
+        return {hand, code, value};
+    }
+    template <class T>
+    static void push(Queue& queue, const T& value) {
+        queue.queueContents(reinterpret_cast<const uint8_t*>(&value),
+                            sizeof(value));
+    }
+};
+TEST_F(PicoemuPipeQueueTest, EmptyQueueHasNoPhantomFrame) {
+    Queue q;
+    EXPECT_FALSE(q.hasData());
+    EXPECT_EQ(q.pickStateWithData(), nullptr);
+}
+TEST_F(PicoemuPipeQueueTest, ButtonEdgesAreFifoAcrossHands) {
+    Queue q;
+    auto down = control(0, 17, 1), other = control(1, 2, 1),
+         up = control(0, 17, 0);
+    push(q, down);
+    push(q, other);
+    push(q, up);
+    for (auto expected : {down, other, up}) {
+        auto p = q.pickStateWithData();
+        ASSERT_NE(p, nullptr);
+        EXPECT_EQ(p->buffer.size(), sizeof(expected));
+        EXPECT_EQ(std::memcmp(p->buffer.data(), &expected, sizeof(expected)),
+                  0);
+        consume(p);
+    }
+    EXPECT_FALSE(q.hasData());
+}
+TEST_F(PicoemuPipeQueueTest, PosesCoalesceOnlySameDevice) {
+    Queue q;
+    std::array<int64_t, 21> hmd{}, left{}, right{};
+    left[0] = 1;
+    right[0] = 2;
+    push(q, hmd);
+    push(q, left);
+    push(q, right);
+    hmd[1] = 99;
+    push(q, hmd);
+    EXPECT_EQ(q.pendingPackets(), 3u);
+    for (auto expected : {hmd, left, right}) {
+        auto p = q.pickStateWithData();
+        ASSERT_NE(p, nullptr);
+        EXPECT_EQ(std::memcmp(p->buffer.data(), &expected, sizeof(expected)),
+                  0);
+        consume(p);
+    }
+}
+TEST_F(PicoemuPipeQueueTest, ClearingThenForcedUpPreservesInProgressPacket) {
+    Queue q;
+    auto down = control(0, 17, 1), up = control(0, 17, 0);
+    push(q, down);
+    auto inProgress = q.pickStateWithData();
+    ASSERT_NE(inProgress, nullptr);
+    push(q, up);
+    q.clearQueued();
+    push(q, up);  // expiry/ownership cleanup MUST re-emit UP
+    EXPECT_EQ(q.pickStateWithData(), inProgress);
+    consume(inProgress);
+    auto next = q.pickStateWithData();
+    ASSERT_NE(next, nullptr);
+    EXPECT_EQ(std::memcmp(next->buffer.data(), &up, sizeof(up)), 0);
+}
+TEST_F(PicoemuPipeQueueTest, EpochInvalidationCannotInterleaveInputFrame) {
+    using namespace std::chrono;
+    auto before = PicoemuPipeManager::beginInputFrame();
+    std::promise<void> started;
+    auto start = started.get_future();
+    auto task = std::async(std::launch::async, [&] {
+        started.set_value();
+        PicoemuPipeManager::invalidateInput();
+    });
+    start.wait();
+    EXPECT_EQ(task.wait_for(milliseconds(10)), std::future_status::timeout);
+    PicoemuPipeManager::endInputFrame();
+    task.get();
+    auto after = PicoemuPipeManager::beginInputFrame();
+    PicoemuPipeManager::endInputFrame();
+    EXPECT_GT(after, before);
+}
+}  // namespace emulation
+}  // namespace android
