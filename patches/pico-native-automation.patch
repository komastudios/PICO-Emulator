diff --git a/android/android-grpc/services/pico-automation/PicoAutomationService.cpp b/android/android-grpc/services/pico-automation/PicoAutomationService.cpp
new file mode 100644
index 00000000..e81386e3
--- /dev/null
+++ b/android/android-grpc/services/pico-automation/PicoAutomationService.cpp
@@ -0,0 +1,153 @@
+// Copyright 2026 Koma Studios. Licensed under the Apache License, Version 2.0.
+#include "PicoAutomationService.h"
+#include <atomic>
+namespace pico {
+namespace automation {
+namespace {
+std::mutex dispatchMutex;
+Dispatcher dispatcher;
+std::atomic<int> queued{0};
+}  // namespace
+void setDispatcher(Dispatcher next) {
+    std::lock_guard<std::mutex> lock(dispatchMutex);
+    dispatcher = std::move(next);
+}
+bool supportedKey(unsigned k) {
+    return (k >= 1 && k <= 83) || k == 87 || k == 88 || k == 96 || k == 97 ||
+           k == 100 || (k >= 102 && k <= 111) || k == 125 || k == 126 ||
+           k == 158;
+}
+class Service final : public v1::PicoAutomation::Service {
+    grpc::Status run(grpc::ServerContext* ctx,
+                     std::shared_ptr<Job> job,
+                     unsigned timeout) {
+        if (!timeout || timeout > 5000)
+            return {grpc::StatusCode::INVALID_ARGUMENT,
+                    "timeout_ms must be 1..5000"};
+        job->deadline = Clock::now() + std::chrono::milliseconds(timeout);
+        if (ctx->deadline() != std::chrono::system_clock::time_point::max()) {
+            auto remaining = ctx->deadline() - std::chrono::system_clock::now();
+            job->deadline = std::min(
+                    job->deadline,
+                    Clock::now() + std::chrono::duration_cast<Clock::duration>(
+                                           remaining));
+        }
+        {
+            std::lock_guard<std::mutex> lock(dispatchMutex);
+            if (!dispatcher)
+                return {grpc::StatusCode::UNAVAILABLE,
+                        "Qt PICO simulator is unavailable"};
+            if (queued.load() >= 64)
+                return {grpc::StatusCode::RESOURCE_EXHAUSTED,
+                        "Qt command queue full"};
+            ++queued;
+            // Count remains until Qt consumes the job, including canceled jobs.
+            auto counted =
+                    std::shared_ptr<Job>(job.get(), [job](Job*) { --queued; });
+            dispatcher(std::move(counted));
+        }
+        std::unique_lock<std::mutex> lock(job->mutex);
+        while (!job->finished) {
+            if (Clock::now() >= job->deadline || ctx->IsCancelled()) {
+                job->canceled = true;
+                return {grpc::StatusCode::DEADLINE_EXCEEDED,
+                        "command expired before Qt completion"};
+            }
+            job->cv.wait_for(lock, std::chrono::milliseconds(5));
+        }
+        return job->status;
+    }
+    grpc::Status GetCapabilities(grpc::ServerContext*,
+                                 const google::protobuf::Empty*,
+                                 v1::Capabilities* out) override {
+        out->set_api_version(1);
+        out->set_lease_ms(5000);
+        out->set_max_timeout_ms(5000);
+        // Host implementation support only: never an assertion of guest
+        // consumption.
+        out->set_native_xr(true);
+        out->set_guest_keyboard(true);
+        out->set_independent_hands(true);
+        for (unsigned k = 1; k < 256; ++k)
+            if (supportedKey(k))
+                out->add_supported_linux_key_codes(k);
+        return grpc::Status::OK;
+    }
+    grpc::Status GetState(grpc::ServerContext* ctx,
+                          const google::protobuf::Empty*,
+                          v1::State* out) override {
+        auto j = std::make_shared<Job>();
+        j->operation = Operation::State;
+        auto s = run(ctx, j, 5000);
+        *out = j->state;
+        return s;
+    }
+    grpc::Status Acquire(grpc::ServerContext* ctx,
+                         const v1::AcquireRequest* in,
+                         v1::Lease* out) override {
+        auto j = std::make_shared<Job>();
+        j->operation = Operation::Acquire;
+        j->acquire = *in;
+        auto s = run(ctx, j, in->timeout_ms());
+        *out = j->lease;
+        return s;
+    }
+    grpc::Status Renew(grpc::ServerContext* ctx,
+                       const v1::Command* in,
+                       v1::Lease* out) override {
+        auto j = std::make_shared<Job>();
+        j->operation = Operation::Renew;
+        j->command = *in;
+        auto s = run(ctx, j, in->timeout_ms());
+        *out = j->lease;
+        return s;
+    }
+    grpc::Status Apply(grpc::ServerContext* ctx,
+                       const v1::ApplyRequest* in,
+                       v1::State* out) override {
+        auto j = std::make_shared<Job>();
+        j->operation = Operation::Apply;
+        j->apply = *in;
+        j->command = in->command();
+        auto s = run(ctx, j, j->command.timeout_ms());
+        *out = j->state;
+        return s;
+    }
+    grpc::Status TimedPress(grpc::ServerContext* ctx,
+                            const v1::TimedPressRequest* in,
+                            v1::State* out) override {
+        auto j = std::make_shared<Job>();
+        j->operation = Operation::TimedPress;
+        j->press = *in;
+        j->command = in->command();
+        auto s = run(ctx, j, j->command.timeout_ms());
+        *out = j->state;
+        return s;
+    }
+    grpc::Status ReleaseAll(grpc::ServerContext* ctx,
+                            const v1::Command* in,
+                            v1::State* out) override {
+        return release(ctx, in, out, Operation::ReleaseAll);
+    }
+    grpc::Status Release(grpc::ServerContext* ctx,
+                         const v1::Command* in,
+                         v1::State* out) override {
+        return release(ctx, in, out, Operation::Release);
+    }
+    grpc::Status release(grpc::ServerContext* ctx,
+                         const v1::Command* in,
+                         v1::State* out,
+                         Operation op) {
+        auto j = std::make_shared<Job>();
+        j->operation = op;
+        j->command = *in;
+        auto s = run(ctx, j, in->timeout_ms());
+        *out = j->state;
+        return s;
+    }
+};
+grpc::Service* createService() {
+    return new Service;
+}
+}  // namespace automation
+}  // namespace pico
diff --git a/android/android-grpc/services/pico-automation/PicoAutomationService.h b/android/android-grpc/services/pico-automation/PicoAutomationService.h
new file mode 100644
index 00000000..1a2b65e1
--- /dev/null
+++ b/android/android-grpc/services/pico-automation/PicoAutomationService.h
@@ -0,0 +1,41 @@
+// Copyright 2026 Koma Studios. Licensed under the Apache License, Version 2.0.
+#pragma once
+#include <chrono>
+#include <condition_variable>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include "pico_automation.grpc.pb.h"
+namespace pico {
+namespace automation {
+using Clock = std::chrono::steady_clock;
+enum class Operation {
+    State,
+    Acquire,
+    Renew,
+    Apply,
+    TimedPress,
+    ReleaseAll,
+    Release
+};
+struct Job {
+    Operation operation;
+    v1::AcquireRequest acquire;
+    v1::Command command;
+    v1::ApplyRequest apply;
+    v1::TimedPressRequest press;
+    v1::State state;
+    v1::Lease lease;
+    Clock::time_point deadline;
+    std::mutex mutex;
+    std::condition_variable cv;
+    bool finished = false;
+    bool canceled = false;
+    grpc::Status status;
+};
+using Dispatcher = std::function<void(std::shared_ptr<Job>)>;
+void setDispatcher(Dispatcher dispatcher);
+grpc::Service* createService();
+bool supportedKey(unsigned key);
+}  // namespace automation
+}  // namespace pico
diff --git a/android/android-grpc/services/pico-automation/proto/pico_automation.proto b/android/android-grpc/services/pico-automation/proto/pico_automation.proto
new file mode 100644
index 00000000..ac1f6758
--- /dev/null
+++ b/android/android-grpc/services/pico-automation/proto/pico_automation.proto
@@ -0,0 +1,88 @@
+syntax = "proto3";
+package pico.automation.v1;
+import "google/protobuf/empty.proto";
+
+// Served on the emulator's existing authenticated gRPC endpoint.
+service PicoAutomation {
+  rpc GetCapabilities(google.protobuf.Empty) returns (Capabilities);
+  rpc GetState(google.protobuf.Empty) returns (State);
+  rpc Acquire(AcquireRequest) returns (Lease);
+  rpc Renew(Command) returns (Lease);
+  rpc Apply(ApplyRequest) returns (State);
+  rpc TimedPress(TimedPressRequest) returns (State);
+  // Exact retry of last successful ReleaseAll is a no-op only while the same
+  // lease is still owned, epoch/token match, and no later sequence succeeded.
+  rpc ReleaseAll(Command) returns (State);
+  // Exact retry of last successful Release is a no-op only while unowned and
+  // epoch/token/sequence match that release and no subsequent Acquire succeeded.
+  // Cleanup retries still require a valid timeout/deadline and ready pipes;
+  // they return current State without mutation or renewal. Never release a new owner.
+  rpc Release(Command) returns (State);
+}
+message Capabilities {
+  uint32 api_version = 1;
+  uint32 lease_ms = 2;
+  uint32 max_timeout_ms = 3;
+  bool native_xr = 4;
+  bool guest_keyboard = 5;
+  bool independent_hands = 6;
+  bool disconnect = 7;
+  repeated uint32 supported_linux_key_codes = 8;
+}
+// input_epoch is opaque and changes on PICO service-start/pipe loss/reconnect.
+message AcquireRequest { string input_epoch = 1; uint32 timeout_ms = 2; }
+message Command {
+  string input_epoch = 1;
+  string lease_token = 2;
+  // Strictly increasing except the exact successful cleanup retries above.
+  uint64 sequence = 3;
+  uint32 timeout_ms = 4;
+}
+message Lease { string input_epoch = 1; string lease_token = 2; uint32 remaining_ms = 3; }
+message Vec3 { double x = 1; double y = 2; double z = 3; }
+message Quaternion { double x = 1; double y = 2; double z = 3; double w = 4; }
+// Metres; +X right, +Y up, -Z forward; unit quaternion xyzw.
+message Pose { Vec3 position = 1; Quaternion orientation = 2; }
+enum Hand { HAND_UNSPECIFIED = 0; LEFT = 1; RIGHT = 2; }
+enum Connection { CONNECTION_UNCHANGED = 0; CONNECT_LEFT = 1; CONNECT_RIGHT = 2; CONNECT_BOTH = 3; }
+enum Button {
+  BUTTON_UNSPECIFIED = 0;
+  HOME = 1; APP = 2; AX = 3; BY = 4; GRIP = 5; STICK = 6; TRIGGER = 7;
+  TOUCH_AX = 8; TOUCH_BY = 9; TOUCH_STICK = 10; TOUCH_TRIGGER = 11; TOUCH_THUMBREST = 12;
+}
+// Presence replaces this hand's controls; omitted pose preserves its pose.
+message HandState {
+  Pose pose = 1;
+  double stick_x = 2; double stick_y = 3; // [-1,1]
+  double trigger = 4; double grip = 5; // [0,1]
+  repeated Button buttons_down = 6;
+}
+// Linux evdev codes, NOT Android keycodes or Qt keys. Entire held-key set.
+// Capability whitelist is authoritative. Injection bypasses Qt shortcuts.
+message KeyboardState { repeated uint32 linux_key_codes_down = 1; }
+message ApplyRequest {
+  Command command = 1;
+  Pose hmd = 2;
+  HandState left = 3;
+  HandState right = 4;
+  KeyboardState keyboard = 5;
+  Connection connection = 6;
+}
+message HandButton { Hand hand = 1; Button button = 2; }
+message TimedPressRequest {
+  Command command = 1;
+  uint32 duration_ms = 2;
+  oneof control { HandButton hand_button = 3; uint32 linux_key_code = 4; }
+}
+message State {
+  string input_epoch = 1;
+  bool ready = 2;
+  bool automation_owned = 3;
+  uint32 lease_remaining_ms = 4;
+  uint64 last_sequence = 5;
+  Pose hmd = 6;
+  HandState left = 7;
+  HandState right = 8;
+  KeyboardState keyboard = 9;
+  Connection connection = 10; // Requested selection; not a guest acknowledgment.
+}
