+using namespace pico::automation;
+namespace p = pico::automation::v1;
+namespace {
+struct Frame {
+    uint64_t epoch;
+    Frame() : epoch(getConsoleAgents()->picopipe->beginInputFrame()) {}
+    ~Frame() { getConsoleAgents()->picopipe->endInputFrame(); }
+};
+std::string uuid() {
+    return QUuid::createUuid().toString(QUuid::WithoutBraces).toStdString();
+}
+unsigned remaining(Clock::time_point d) {
+    auto n = std::chrono::duration_cast<std::chrono::milliseconds>(d -
+                                                                   Clock::now())
+                     .count();
+    return n > 0 ? static_cast<unsigned>(n) : 0;
+}
+void poseToProto(const QVector3D& v, const QQuaternion& r, p::Pose* out) {
+    out->mutable_position()->set_x(v.x());
+    out->mutable_position()->set_y(v.y());
+    out->mutable_position()->set_z(v.z());
+    out->mutable_orientation()->set_x(r.x());
+    out->mutable_orientation()->set_y(r.y());
+    out->mutable_orientation()->set_z(r.z());
+    out->mutable_orientation()->set_w(r.scalar());
+}
+QVector3D position(const p::Pose& p) {
+    return {float(p.position().x()), float(p.position().y()),
+            float(p.position().z())};
+}
+QQuaternion rotation(const p::Pose& p) {
+    return QQuaternion(float(p.orientation().w()), float(p.orientation().x()),
+                       float(p.orientation().y()), float(p.orientation().z()))
+            .normalized();
+}
+bool validPose(const p::Pose& p) {
+    if (!p.has_position() || !p.has_orientation())
+        return false;
+    for (double x : {p.position().x(), p.position().y(), p.position().z()})
+        if (!std::isfinite(x) || std::abs(x) > 100000)
+            return false;
+    auto r = p.orientation();
+    double n = r.x() * r.x() + r.y() * r.y() + r.z() * r.z() + r.w() * r.w();
+    return std::isfinite(n) && std::abs(n - 1) < 0.001;
+}
+bool pressed(const p::HandState& h, int b) {
+    for (int x : h.buttons_down())
+        if (x == b)
+            return true;
+    return false;
+}
+bool validHand(const p::HandState& h) {
+    if (h.has_pose() && !validPose(h.pose()))
+        return false;
+    for (double x : {h.stick_x(), h.stick_y()})
+        if (!std::isfinite(x) || std::abs(x) > 1)
+            return false;
+    for (double x : {h.trigger(), h.grip()})
+        if (!std::isfinite(x) || x < 0 || x > 1)
+            return false;
+    std::set<int> seen;
+    for (int b : h.buttons_down())
+        if (b < 1 || b > 12 || !seen.insert(b).second)
+            return false;
+    // Analog values and digital click state are independent, as on real XR
+    // controllers.
+    return true;
+}
+bool validKeys(const p::KeyboardState& k) {
+    std::set<unsigned> seen;
+    for (unsigned x : k.linux_key_codes_down())
+        if (!supportedKey(x) || !seen.insert(x).second)
+            return false;
+    return true;
+}
+const int keycode[] = {-1, 0, 1, 2, 3, 4, 5, 17, 10, 11, 12, 13, 14};
+void changeButton(p::HandState* h, int b, bool down) {
+    std::set<int> values(h->buttons_down().begin(), h->buttons_down().end());
+    if (down)
+        values.insert(b);
+    else
+        values.erase(b);
+    h->clear_buttons_down();
+    for (int x : values)
+        h->add_buttons_down(static_cast<p::Button>(x));
+    if (b == p::TRIGGER)
+        h->set_trigger(down ? 1 : 0);
+    if (b == p::GRIP)
+        h->set_grip(down ? 1 : 0);
+}
+}  // namespace
+PicoAutomation::PicoAutomation(PicoUiCommandHandle* owner)
+    : QObject(owner), mOwner(owner), mEpochPrefix(uuid()) {
+    qApp->installEventFilter(this);
+    setDispatcher([this](std::shared_ptr<Job> job) {
+        QMetaObject::invokeMethod(
+                this, [this, job]() { execute(job); }, Qt::QueuedConnection);
+    });
+    mTimer.setTimerType(Qt::PreciseTimer);
+    mTimer.setInterval(5);
+    connect(&mTimer, &QTimer::timeout, this, [this]() { tick(); });
+    mTimer.start();
+    Frame f;
+    synchronize(f.epoch);
+}
+PicoAutomation::~PicoAutomation() {
+    setDispatcher({});
+    mTimer.stop();
+    Frame f;
+    neutralize(true);
+}
+bool PicoAutomation::eventFilter(QObject*, QEvent* event) {
+    if (!owned())
+        return false;
+    switch (event->type()) {
+        case QEvent::KeyPress:
+        case QEvent::KeyRelease:
+        case QEvent::Shortcut:
+        case QEvent::ShortcutOverride:
+        case QEvent::MouseButtonPress:
+        case QEvent::MouseButtonRelease:
+        case QEvent::MouseButtonDblClick:
+        case QEvent::MouseMove:
+        case QEvent::Wheel:
+        case QEvent::Gesture:
+        case QEvent::TouchBegin:
+        case QEvent::TouchUpdate:
+        case QEvent::TouchEnd:
+            return true;
+        default:
+            return false;
+    }
+}
+void PicoAutomation::serviceStarted() {
+    Frame f;
+    synchronize(f.epoch);
+}
+void PicoAutomation::synchronize(uint64_t epoch) {
+    if (epoch != mPipeEpoch) {
+        // Queued UP may have been lost after Release already cleared the token.
+        // Keep recovery pending across closed pipes, independently of ownership.
+        mPendingNeutralBaseline = true;
+        neutralize(true);
+        ++mOwner->controllerSimulator()->mUiGeneration;
+        mPipeEpoch = epoch;
+        mEpoch = mEpochPrefix + ":" + std::to_string(epoch);
+        mSequence = 0;
+        mReleasedToken.clear();
+        mReleaseAllSequence = 0;
+    }
+    if (mPendingNeutralBaseline && getConsoleAgents()->picopipe->inputReady()) {
+        neutralize(true, true);
+        mPendingNeutralBaseline = false;
+    }
+    if (owned() && Clock::now() >= mLeaseDeadline)
+        neutralize(true);
+}
+void PicoAutomation::tick() {
+    Frame f;
+    synchronize(f.epoch);
+    expirePresses();
+}
+void PicoAutomation::snapshot(p::State& out) {
+    mState.set_input_epoch(mEpoch);
+    mState.set_ready(getConsoleAgents()->picopipe->inputReady());
+    mState.set_automation_owned(owned());
+    mState.set_lease_remaining_ms(owned() ? remaining(mLeaseDeadline) : 0);
+    mState.set_last_sequence(mSequence);
+    auto h = mOwner->hmdSimulator();
+    poseToProto(h->mHmdPosition, h->mHmdRotation, mState.mutable_hmd());
+    auto c = mOwner->controllerSimulator();
+    for (int hand = 0; hand < 2; ++hand) {
+        auto value = hand == 0 ? mState.mutable_left() : mState.mutable_right();
+        value->clear_buttons_down();
+        for (int b = 1; b <= 12; ++b)
+            if (c->mInputControls[hand][keycode[b]])
+                value->add_buttons_down(static_cast<p::Button>(b));
+        value->set_trigger(c->mInputControls[hand][6] / 255.0);
+        value->set_grip(c->mInputControls[hand][7] / 255.0);
+        auto axis = [](int x) {
+            return x < 128 ? (x - 128) / 128.0 : (x - 128) / 127.0;
+        };
+        value->set_stick_x(axis(c->mInputControls[hand][15]));
+        value->set_stick_y(axis(c->mInputControls[hand][16]));
+        const auto& p = c->mIndependentStates[hand].pose;
+        poseToProto(QVector3D(p.x, p.y, p.z),
+                    QQuaternion(p.rw, p.rx, p.ry, p.rz),
+                    (hand == 0 ? mState.mutable_left() : mState.mutable_right())
+                            ->mutable_pose());
+    }
+    out = mState;
+}
+void PicoAutomation::sendControls(int hand,
+                                  const p::HandState& h,
+                                  bool forceNeutral) {
+    auto c = mOwner->controllerSimulator();
+    auto send = [&](int code, int value) {
+        // Cache equality does not prove the guest consumed the prior release.
+        bool force =
+                forceNeutral && (code > 1 || c->mTouchedControls[hand][code]);
+        if (force || c->mInputControls[hand][code] != value)
+            c->sendControllerKeyToGuest(hand, code, value);
+    };
+    for (int b = 1; b <= 12; ++b)
+        send(keycode[b], pressed(h, b) ? 1 : 0);
+    // Send analog last: legacy click helper expands trigger/grip to endpoint
+    // values.
+    send(6, std::lround(h.trigger() * 255));
+    send(7, std::lround(h.grip() * 255));
+    auto axis = [](double x) {
+        return x < 0 ? int(std::lround(128 + x * 128))
+                     : int(std::lround(128 + x * 127));
+    };
+    send(15, axis(h.stick_x()));
+    send(16, axis(h.stick_y()));
+}
+void PicoAutomation::setKeyboard(const p::KeyboardState& value) {
+    std::set<unsigned> old(mState.keyboard().linux_key_codes_down().begin(),
+                           mState.keyboard().linux_key_codes_down().end());
+    std::set<unsigned> next(value.linux_key_codes_down().begin(),
+                            value.linux_key_codes_down().end());
+    for (unsigned k : old)
+        if (!next.count(k))
+            getConsoleAgents()->user_event->sendKey(k, false);
+    for (unsigned k : next)
+        if (!old.count(k))
+            getConsoleAgents()->user_event->sendKey(k, true);
+    *mState.mutable_keyboard() = value;
+}
+void PicoAutomation::neutralize(bool release, bool forceBaseline) {
+    mPresses.clear();
+    if (owned() || forceBaseline) {
+        getConsoleAgents()->picopipe->clearInputQueue();
+        p::HandState zero;
+        sendControls(0, zero, true);
+        sendControls(1, zero, true);
+        setKeyboard(p::KeyboardState{});
+        mState.mutable_left()->Clear();
+        mState.mutable_right()->Clear();
+        auto h = mOwner->hmdSimulator();
+        h->mPressedKeys.clear();
+        h->mMovementTimer->stop();
+        h->mPressedModifier = Qt::NoModifier;
+        h->mHmdState = {};
+        h->mLastHmdState = {};
+        h->mGestureSensitivity = 0;
+        h->mWheelSensitivity = 0;
+        h->mTouchpadInput = {};
+        auto c = mOwner->controllerSimulator();
+        c->mPressedKeys.clear();
+        ++c->mUiGeneration;
+        // Preserve each pose while clearing motion derivatives.
+        for (auto& state : c->mIndependentStates) {
+            auto pose = state.pose;
+            state = {};
+            state.pose = pose;
+        }
+    }
+    if (release)
+        mToken.clear();
+}
+void PicoAutomation::cancelPresses(int hand) {
+    for (auto it = mPresses.begin(); it != mPresses.end();) {
+        if ((hand == 2 && it->first >= 1000) ||
+            (hand < 2 && it->first / 100 == hand))
+            it = mPresses.erase(it);
+        else
+            ++it;
+    }
+}
+void PicoAutomation::expirePresses() {
+    if (!owned())
+        return;
+    for (auto it = mPresses.begin(); it != mPresses.end();) {
+        if (Clock::now() < it->second) {
+            ++it;
+            continue;
+        }
+        int key = it->first;
+        it = mPresses.erase(it);
+        if (key >= 1000) {
+            p::KeyboardState k;
+            for (unsigned v : mState.keyboard().linux_key_codes_down())
+                if (v != unsigned(key - 1000))
+                    k.add_linux_key_codes_down(v);
+            setKeyboard(k);
+        } else {
+            int hand = key / 100, b = key % 100;
+            auto h = hand == 0 ? mState.mutable_left() : mState.mutable_right();
+            changeButton(h, b, false);
+            sendControls(hand, *h);
+        }
+    }
+}
+void PicoAutomation::execute(std::shared_ptr<Job> j) {
+    std::lock_guard<std::mutex> lock(j->mutex);
+    Frame frame;
+    synchronize(frame.epoch);
+    expirePresses();
+    auto fail = [&](grpc::StatusCode code, const char* message) {
+        j->status = {code, message};
+    };
+    auto perform = [&]() {
+        if (j->canceled || Clock::now() >= j->deadline) {
+            fail(grpc::StatusCode::DEADLINE_EXCEEDED,
+                 "command expired on Qt thread");
+            return;
+        }
+        if (j->operation == Operation::State) {
+            snapshot(j->state);
+            return;
+        }
+        if (!getConsoleAgents()->picopipe->inputReady()) {
+            fail(grpc::StatusCode::FAILED_PRECONDITION,
+                 "PICO input pipes unavailable");
+            return;
+        }
+        if (j->operation == Operation::Acquire) {
+            if (j->acquire.input_epoch() != mEpoch) {
+                fail(grpc::StatusCode::FAILED_PRECONDITION,
+                     "input epoch changed");
+                return;
+            }
+            if (owned()) {
+                fail(grpc::StatusCode::RESOURCE_EXHAUSTED,
+                     "automation already leased");
+                return;
+            }
+            // Quiesce UI key/movement state before transferring ownership.
+            QEvent leave(QEvent::Leave);
+            mOwner->handleQtLeaveEvent(&leave);
+            auto c = mOwner->controllerSimulator();
+            ++c->mUiGeneration;
+            c->mIndependentPoses = true;
+            mToken = uuid();
+            mReleasedToken.clear();
+            mReleaseAllSequence = 0;
+            mSequence = 0;
+            mLeaseDeadline = Clock::now() + std::chrono::milliseconds(5000);
+            neutralize(false);
+        } else {
+            const auto& cmd = j->command;
+            // Retry of the last cleanup is a no-op only for the same
+            // epoch/owner.
+            if (cmd.input_epoch() == mEpoch &&
+                ((j->operation == Operation::Release && !owned() &&
+                  !mReleasedToken.empty() &&
+                  cmd.lease_token() == mReleasedToken &&
+                  cmd.sequence() == mReleasedSequence) ||
+                 (j->operation == Operation::ReleaseAll && owned() &&
+                  mReleaseAllSequence != 0 &&
+                  cmd.lease_token() == mToken && cmd.sequence() == mSequence &&
+                  mSequence == mReleaseAllSequence))) {
+                snapshot(j->state);
+                return;
+            }
+            switch (checkCommand(mEpoch, cmd.input_epoch(), mToken,
+                                 cmd.lease_token(), mSequence, cmd.sequence(),
+                                 Clock::now(), j->deadline, mLeaseDeadline)) {
+                case Rejection::Deadline:
+                    fail(grpc::StatusCode::DEADLINE_EXCEEDED,
+                         "expired command");
+                    return;
+                case Rejection::Epoch:
+                    fail(grpc::StatusCode::FAILED_PRECONDITION,
+                         "input epoch changed");
+                    return;
+                case Rejection::Token:
+                    fail(grpc::StatusCode::PERMISSION_DENIED,
+                         "lease invalid or expired");
+                    return;
+                case Rejection::Sequence:
+                    fail(grpc::StatusCode::ABORTED, "sequence must increase");
+                    return;
+                case Rejection::None:
+                    break;
+            }
+            if ((j->operation == Operation::Apply ||
+                 j->operation == Operation::TimedPress) &&
+                !getConsoleAgents()->picopipe->inputCapacity()) {
+                fail(grpc::StatusCode::RESOURCE_EXHAUSTED,
+                     "guest control queue is full");
+                return;
+            }
+            if (j->operation == Operation::Apply) {
+                const auto& a = j->apply;
+                if ((a.has_hmd() && !validPose(a.hmd())) ||
+                    (a.has_left() && !validHand(a.left())) ||
+                    (a.has_right() && !validHand(a.right())) ||
+                    (a.has_keyboard() && !validKeys(a.keyboard())) ||
+                    a.connection() < 0 || a.connection() > 3) {
+                    fail(grpc::StatusCode::INVALID_ARGUMENT,
+                         "invalid pose, controls, keyboard or connection");
+                    return;
+                }
+                if (a.has_hmd()) {
+                    auto h = mOwner->hmdSimulator();
+                    h->mHmdPosition = position(a.hmd());
+                    h->mHmdRotation = rotation(a.hmd());
+                    h->updateDirectionVectors();
+                    h->resetHelperVariables();
+                }
+                for (int hand = 0; hand < 2; ++hand) {
+                    if (hand == 0 ? !a.has_left() : !a.has_right())
+                        continue;
+                    const auto& value = hand == 0 ? a.left() : a.right();
+                    cancelPresses(hand);
+                    if (value.has_pose())
+                        mOwner->controllerSimulator()->setIndependentPose(
+                                hand, position(value.pose()),
+                                rotation(value.pose()));
+                    *(hand == 0 ? mState.mutable_left()
+                                : mState.mutable_right()) = value;
+                    sendControls(hand, value);
+                }
+                if (a.has_keyboard()) {
+                    cancelPresses(2);
+                    setKeyboard(a.keyboard());
+                }
+                if (a.connection() != p::CONNECTION_UNCHANGED) {
+                    mOwner->controllerSimulator()->connectController(
+                            int(a.connection()) - 1);
+                    mState.set_connection(a.connection());
+                }
+                mOwner->hmdSimulator()->sendHmdPoseToGuest();
+            } else if (j->operation == Operation::TimedPress) {
+                auto& req = j->press;
+                int key;
+                if (!req.duration_ms() || req.duration_ms() > 5000) {
+                    fail(grpc::StatusCode::INVALID_ARGUMENT,
+                         "duration_ms must be 1..5000");
+                    return;
+                }
+                if (req.has_hand_button()) {
+                    int hand = req.hand_button().hand(),
+                        b = req.hand_button().button();
+                    if (hand < 1 || hand > 2 || b < 1 || b > 12) {
+                        fail(grpc::StatusCode::INVALID_ARGUMENT,
+                             "invalid hand button");
+                        return;
+                    }
+                    --hand;
+                    key = hand * 100 + b;
+                    auto h = hand == 0 ? mState.mutable_left()
+                                       : mState.mutable_right();
+                    if (pressed(*h, b)) {
+                        fail(grpc::StatusCode::FAILED_PRECONDITION,
+                             "control already held");
+                        return;
+                    }
+                    changeButton(h, b, true);
+                    sendControls(hand, *h);
+                } else if (req.control_case() ==
+                                   p::TimedPressRequest::kLinuxKeyCode &&
+                           supportedKey(req.linux_key_code())) {
+                    key = 1000 + req.linux_key_code();
+                    auto k = mState.keyboard();
+                    for (unsigned v : k.linux_key_codes_down())
+                        if (v == req.linux_key_code()) {
+                            fail(grpc::StatusCode::FAILED_PRECONDITION,
+                                 "key already held");
+                            return;
+                        }
+                    k.add_linux_key_codes_down(req.linux_key_code());
+                    setKeyboard(k);
+                } else {
+                    fail(grpc::StatusCode::INVALID_ARGUMENT,
+                         "invalid timed control");
+                    return;
+                }
+                mPresses[key] = pressDeadline(Clock::now(), req.duration_ms(),
+                                              mLeaseDeadline);
+            } else if (j->operation == Operation::Renew) {
+                mLeaseDeadline = Clock::now() + std::chrono::milliseconds(5000);
+            } else {
+                if (j->operation == Operation::Release) {
+                    mReleasedToken = mToken;
+                    mReleasedSequence = cmd.sequence();
+                } else
+                    mReleaseAllSequence = cmd.sequence();
+                neutralize(j->operation == Operation::Release);
+            }
+            mSequence = cmd.sequence();
+        }
+        j->lease.set_input_epoch(mEpoch);
+        j->lease.set_lease_token(mToken);
+        j->lease.set_remaining_ms(owned() ? remaining(mLeaseDeadline) : 0);
+        snapshot(j->state);
+    };
+    perform();
+    j->finished = true;
+    j->cv.notify_all();
+}
